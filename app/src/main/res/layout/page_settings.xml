<?xml version="1.0" encoding="utf-8"?>
<com.maichimod.prototype.ContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_page" style="@style/Widget.Maichi.Screen"
    android:focusableInTouchMode="true" android:visibility="gone">
    <FrameLayout style="@style/Widget.Maichi.PageHeader">
        <com.maichimod.prototype.MedioraButton android:id="@+id/settings_back"
            style="@style/Widget.Maichi.PageBack" android:contentDescription="@string/home" />
        <TextView style="@style/Widget.Maichi.PageTitle" android:text="@string/settings" />
        <com.maichimod.prototype.MedioraButton android:id="@+id/connection_mode_button"
            style="@style/Widget.Maichi.ConnectionModeButton" android:layout_gravity="end|center_vertical"
            android:text="@string/connection_mode" />
    </FrameLayout>
    <HorizontalScrollView android:id="@+id/settings_tabs_scroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginVertical="12dp" android:scrollbars="none">
        <RadioGroup android:id="@+id/settings_tabs" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:padding="4dp" android:background="@drawable/settings_tabs_track"
            android:checkedButton="@id/settings_tab_local">
            <com.maichimod.prototype.MedioraSettingsTab android:id="@+id/settings_tab_local"
                style="@style/Widget.Maichi.SettingsTab" android:drawableStart="@drawable/ic_tab_network"
                android:text="@string/local_network_settings" />
            <com.maichimod.prototype.MedioraSettingsTab android:id="@+id/settings_tab_devices"
                style="@style/Widget.Maichi.SettingsTab" android:layout_marginStart="2dp"
                android:drawableStart="@drawable/ic_settings_devices" android:text="@string/door_device_settings" />
            <com.maichimod.prototype.MedioraSettingsTab android:id="@+id/settings_tab_sound"
                style="@style/Widget.Maichi.SettingsTab" android:layout_marginStart="2dp"
                android:drawableStart="@drawable/ic_settings_sound" android:text="@string/sound_and_call_settings" />
            <com.maichimod.prototype.MedioraSettingsTab android:id="@+id/settings_tab_appearance"
                style="@style/Widget.Maichi.SettingsTab" android:layout_marginStart="2dp"
                android:drawableStart="@drawable/ic_settings_appearance" android:text="@string/appearance_settings" />
        </RadioGroup>
    </HorizontalScrollView>
    <ScrollView android:id="@+id/settings_scroll" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"
        android:clipToPadding="false" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/local_section" style="@style/Widget.Maichi.SettingsSection">
                <TextView style="@style/Widget.Maichi.SectionTitle" android:text="@string/local_network_settings" />
                <TextView style="@style/Widget.Maichi.SettingsDescription" android:text="@string/local_network_help" />
                <com.maichimod.prototype.SettingsFormGrid android:id="@+id/local_parameters"
                    style="@style/Widget.Maichi.SettingsForm" />
                <View style="@style/Widget.Maichi.SettingsDivider" />
                <TextView android:id="@+id/settings_connection_status" style="@style/Widget.Maichi.Status"
                    android:layout_gravity="start" android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/ethernet_details" style="@style/Widget.Maichi.Label"
                    android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:visibility="gone" />
                <com.maichimod.prototype.MedioraButton android:id="@+id/retry_ethernet"
                    style="@style/Widget.Maichi.SettingsAction" android:layout_marginTop="8dp"
                    android:text="@string/retry_monitor" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/peer_section" style="@style/Widget.Maichi.SettingsSection" android:visibility="gone">
                <TextView style="@style/Widget.Maichi.SectionTitle" android:text="@string/door_device_settings" />
                <TextView style="@style/Widget.Maichi.SettingsDescription" android:text="@string/door_device_help" />
                <com.maichimod.prototype.SettingsFormGrid android:id="@+id/peer_parameters"
                    style="@style/Widget.Maichi.SettingsForm" />
            </LinearLayout>
            <LinearLayout android:id="@+id/volume_section" style="@style/Widget.Maichi.SettingsSection" android:visibility="gone">
                <TextView style="@style/Widget.Maichi.SectionTitle" android:text="@string/sound_and_call_settings" />
                <TextView style="@style/Widget.Maichi.SettingsDescription" android:text="@string/sound_settings_help" />
                <include android:id="@+id/media_volume" layout="@layout/volume_control"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
                <View style="@style/Widget.Maichi.SettingsDivider" android:layout_marginVertical="16dp" />
                <include android:id="@+id/call_volume" layout="@layout/volume_control" />
                <TextView android:id="@+id/volume_hint" style="@style/Widget.Maichi.SettingsDescription"
                    android:layout_marginTop="12dp" android:text="@string/volume_immediate" />
                <View style="@style/Widget.Maichi.SettingsDivider" android:layout_marginVertical="24dp" />
                <com.maichimod.prototype.MedioraSwitch android:id="@+id/auto_hang_up_after_unlock"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:paddingVertical="8dp" android:gravity="center_vertical"
                    android:text="@string/auto_hang_up_after_unlock" android:textColor="@color/text" android:textSize="@dimen/label_size" />
                <TextView style="@style/Widget.Maichi.SettingsDescription" android:text="@string/auto_hang_up_after_unlock_help" />
            </LinearLayout>
            <LinearLayout android:id="@+id/appearance_section" style="@style/Widget.Maichi.SettingsSection" android:visibility="gone">
                <TextView style="@style/Widget.Maichi.SectionTitle" android:text="@string/theme_color" />
                <TextView style="@style/Widget.Maichi.SettingsDescription" android:text="@string/theme_color_help" />
                <com.maichimod.prototype.SettingsFormGrid android:id="@+id/theme_choices" style="@style/Widget.Maichi.SettingsForm" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.maichimod.prototype.ContentLayout>
