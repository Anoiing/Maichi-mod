<?xml version="1.0" encoding="utf-8"?>
<com.maichimod.prototype.ContentLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/monitor_sources" style="@style/Widget.Maichi.Screen" android:visibility="gone">
    <FrameLayout style="@style/Widget.Maichi.PageHeader">
        <com.maichimod.prototype.MedioraButton android:id="@+id/sources_back" style="@style/Widget.Maichi.PageBack" android:contentDescription="@string/home" />
        <TextView style="@style/Widget.Maichi.PageTitle" android:text="@string/monitor" />
        <ImageView android:id="@+id/sources_state" style="@style/Widget.Maichi.NetworkStatus" android:contentDescription="@string/network_status" />
    </FrameLayout>
    <TextView style="@style/Widget.Maichi.Label" android:layout_marginTop="24dp" android:text="@string/source_hint" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:layout_marginTop="16dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.maichimod.prototype.ContentLayout style="@style/Widget.Maichi.TileRow" android:minHeight="@dimen/tile_row_max_height" android:maxHeight="0dp">
                <com.maichimod.prototype.MaterialPanel android:id="@+id/unit_monitor" style="@style/Widget.Maichi.SourceTile">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/tile_caption_inset">
                        <ImageView style="@style/Widget.Maichi.TileIcon" android:layout_gravity="start" android:src="@drawable/ic_camera" android:contentDescription="@null" />
                        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView style="@style/Widget.Maichi.SourceName" android:text="@string/unit_door_station" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="24dp" android:background="@color/divider" />
                        <TextView android:id="@+id/source_detail" style="@style/Widget.Maichi.TileDetail" android:layout_marginTop="12dp" android:drawableEnd="@drawable/ic_chevron_right" android:text="@string/view_camera" />
                    </LinearLayout>
                </com.maichimod.prototype.MaterialPanel>
                <com.maichimod.prototype.MaterialPanel android:id="@+id/basement_one_monitor" style="@style/Widget.Maichi.SourceTile" android:layout_marginStart="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/tile_caption_inset">
                        <ImageView style="@style/Widget.Maichi.TileIcon" android:layout_gravity="start" android:src="@drawable/ic_camera" android:contentDescription="@null" />
                        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView style="@style/Widget.Maichi.SourceName" android:text="@string/basement_door_station_one" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="24dp" android:background="@color/divider" />
                        <TextView android:id="@id/source_detail" style="@style/Widget.Maichi.TileDetail" android:layout_marginTop="12dp" android:drawableEnd="@drawable/ic_chevron_right" android:text="@string/view_camera" />
                    </LinearLayout>
                </com.maichimod.prototype.MaterialPanel>
                <com.maichimod.prototype.MaterialPanel android:id="@+id/basement_two_monitor" style="@style/Widget.Maichi.SourceTile" android:layout_marginStart="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/tile_caption_inset">
                        <ImageView style="@style/Widget.Maichi.TileIcon" android:layout_gravity="start" android:src="@drawable/ic_camera" android:contentDescription="@null" />
                        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView style="@style/Widget.Maichi.SourceName" android:text="@string/basement_door_station_two" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="24dp" android:background="@color/divider" />
                        <TextView android:id="@id/source_detail" style="@style/Widget.Maichi.TileDetail" android:layout_marginTop="12dp" android:drawableEnd="@drawable/ic_chevron_right" android:text="@string/view_camera" />
                    </LinearLayout>
                </com.maichimod.prototype.MaterialPanel>
            </com.maichimod.prototype.ContentLayout>
        </FrameLayout>
    </ScrollView>
    <TextView style="@style/Widget.Maichi.Label" android:layout_marginTop="16dp" android:textSize="@dimen/caption_size" android:text="@string/monitor_limit_hint" />
</com.maichimod.prototype.ContentLayout>
