<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Maichi" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:alertDialogTheme">@style/Theme.Maichi.Dialog</item>
    </style>

    <style name="Theme.Maichi.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/amber</item>
        <item name="android:colorBackgroundFloating">@color/panel</item>
    </style>

    <style name="Widget.Maichi.Screen" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:maxWidth">@dimen/content_max_width</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">@dimen/screen_gutter</item>
        <item name="android:paddingVertical">@dimen/screen_vertical</item>
    </style>

    <style name="Widget.Maichi.PageHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/page_header_height</item>
    </style>

    <style name="Widget.Maichi.PageTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/page_title_size</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>

    <style name="Widget.Maichi.PageBack" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:drawableStart">@drawable/ic_back</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">68dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">@dimen/label_size</item>
    </style>

    <style name="Widget.Maichi.Status" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:drawableStart">@drawable/status_dot</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">@dimen/label_size</item>
    </style>

    <style name="Widget.Maichi.TileRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:maxHeight">@dimen/tile_row_max_height</item>
        <item name="android:baselineAligned">false</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Widget.Maichi.Tile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/tile_panel</item>
    </style>

    <style name="Widget.Maichi.TileIcon" parent="">
        <item name="android:layout_width">@dimen/tile_icon_size</item>
        <item name="android:layout_height">@dimen/tile_icon_size</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/tile_icon_frame</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">@dimen/tile_icon_inset</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Widget.Maichi.TileCaption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">@dimen/tile_caption_inset</item>
        <item name="android:paddingVertical">@dimen/tile_caption_inset</item>
    </style>

    <style name="Widget.Maichi.TileTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/tile_title_size</item>
    </style>

    <style name="Widget.Maichi.TileDetail" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">@dimen/label_size</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.Maichi.SourceName" parent="Widget.Maichi.TileTitle">
        <item name="android:importantForAccessibility">auto</item>
        <item name="android:textSize">@dimen/page_title_size</item>
    </style>

    <style name="Widget.Maichi.Section" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal|top</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/section_inset</item>
        <item name="android:background">@drawable/settings_panel</item>
    </style>

    <style name="Widget.Maichi.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/section_title_size</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>

    <style name="Widget.Maichi.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">@dimen/label_size</item>
    </style>

    <style name="Widget.Maichi.ModeOption" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/setting_control</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">4dp</item>
        <item name="android:textColor">@color/control_text</item>
        <item name="android:textSize">@dimen/label_size</item>
    </style>

    <style name="Widget.Maichi.SettingInput" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/setting_control</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted_text</item>
        <item name="android:textSize">@dimen/label_size</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:inputType">textVisiblePassword</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Widget.Maichi.SettingsAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:textColor">@color/amber</item>
        <item name="android:textSize">@dimen/label_size</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Maichi.ConnectionModeButton" parent="Widget.Maichi.SettingsAction">
        <item name="android:background">@drawable/connection_mode_button</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_down</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">0dp</item>
    </style>

    <style name="Widget.Maichi.VolumeButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">@dimen/volume_button_size</item>
        <item name="android:layout_height">@dimen/volume_button_size</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/setting_control</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/control_text</item>
        <item name="android:textSize">23sp</item>
    </style>

    <style name="Widget.Maichi.PrimaryButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:background">@drawable/primary_button</item>
        <item name="android:textColor">@color/on_amber</item>
        <item name="android:textSize">@dimen/label_size</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
