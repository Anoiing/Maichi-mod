<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/field_help"
            style="@style/Widget.Maichi.Label"
            android:layout_width="match_parent"
            android:lineSpacingExtra="3dp" />

        <EditText
            android:id="@+id/field_input"
            style="@style/Widget.Maichi.SettingInput"
            android:layout_marginTop="12dp"
            android:hint="@string/parameter_value"
            android:importantForAutofill="no"
            android:imeOptions="actionDone|flagNoExtractUi" />

        <TextView
            android:id="@+id/field_error"
            style="@style/Widget.Maichi.Label"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/status_error"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
