    <item name="android:layout_width">50dp</item>
    <item name="android:layout_height">50dp</item>
    <item name="android:layout_gravity">start|center_vertical</item>
    <item name="android:background">@null</item>
    <item name="android:drawableStart">@drawable/ic_back</item>
    <item name="android:drawablePadding">0dp</item>
    <item name="android:gravity">center</item>
    <item name="android:minWidth">0dp</item>
    <item name="android:padding">12dp</item>
    <item name="android:textColor">@color/secondary_text_state</item>
    <item name="android:textSize">@dimen/label_size</item>
  </style>
  <style name="Widget.Maichi.Status" parent="">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_gravity">end|center_vertical</item>
    <item name="android:drawableStart">@drawable/status_dot</item>
