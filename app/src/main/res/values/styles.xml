    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">8dp</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:textColor">@color/secondary_text_state</item>
    <item name="android:textSize">@dimen/label_size</item>
    <item name="android:maxLines">2</item>
    <item name="android:ellipsize">end</item>
  </style>
  <style name="Widget.Maichi.SourceName" parent="Widget.Maichi.TileTitle">
    <item name="android:importantForAccessibility">auto</item>
  </style>
  <style name="Widget.Maichi.SectionTitle" parent="">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textFontWeight" ns0:targetApi="28">600</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:textColor">@color/content_text</item>
    <item name="android:textSize">@dimen/section_title_size</item>
    <item name="android:accessibilityHeading" ns0:targetApi="28">true</item>
  </style>
  <style name="Widget.Maichi.Label" parent="">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
