<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#29F0C795">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape>
                    <corners android:radius="6dp" />
                    <solid android:color="#45382D" />
                    <stroke android:width="1dp" android:color="@color/amber" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape>
                    <corners android:radius="6dp" />
                    <solid android:color="#34363B" />
                    <stroke android:width="1dp" android:color="@color/amber" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="6dp" />
                    <solid android:color="#282B30" />
                    <stroke android:width="1dp" android:color="#484B50" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
