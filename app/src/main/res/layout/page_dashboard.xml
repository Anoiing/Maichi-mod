<?xml version="1.0" encoding="utf-8"?>
<com.maichimod.prototype.ContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard"
    style="@style/Widget.Maichi.Screen">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_header_height">

        <TextClock
            style="@style/Widget.Maichi.Label"
            android:layout_gravity="start|center_vertical"
            android:format12Hour="MM/dd EEE"
            android:format24Hour="MM/dd EEE" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="0.025"
            android:textColor="@color/amber"
            android:textSize="@dimen/clock_size" />

        <TextView
            android:id="@+id/connection_state"
            style="@style/Widget.Maichi.Status"
            android:accessibilityLiveRegion="polite"
            android:text="@string/loading_samples" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/divider" />
    </FrameLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="0.85" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5">

        <com.maichimod.prototype.ContentLayout style="@style/Widget.Maichi.TileRow">

            <LinearLayout
                android:id="@+id/monitor_tile"
                style="@style/Widget.Maichi.Tile"
                android:orientation="vertical"
                android:layout_weight="1.22"
                android:background="@drawable/tile_monitor"
                android:contentDescription="@string/monitor">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        style="@style/Widget.Maichi.TileIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_monitor"
                        android:tint="@color/on_amber" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/tile_caption_inset"
                    android:background="#40261C15" />

                <LinearLayout style="@style/Widget.Maichi.TileCaption">
                    <TextView
                        style="@style/Widget.Maichi.TileTitle"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawableTint="@color/on_amber"
                        android:textColor="@color/on_amber"
                        android:text="@string/monitor" />

                    <TextView
                        style="@style/Widget.Maichi.TileDetail"
                        android:textColor="@color/on_amber_secondary"
                        android:importantForAccessibility="no"
                        android:text="@string/choose_door_station" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/elevator_tile"
                style="@style/Widget.Maichi.Tile"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/tile_gap"
                android:contentDescription="@string/elevator">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        style="@style/Widget.Maichi.TileIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_elevator" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/tile_caption_inset"
                    android:background="@color/divider" />

                <LinearLayout style="@style/Widget.Maichi.TileCaption">
                    <TextView
                        style="@style/Widget.Maichi.TileTitle"
                        android:text="@string/elevator" />

                    <TextView
                        android:id="@+id/elevator_state"
                        style="@style/Widget.Maichi.TileDetail"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/call_home_floor" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_button"
                style="@style/Widget.Maichi.Tile"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/tile_gap"
                android:contentDescription="@string/settings">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        style="@style/Widget.Maichi.TileIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/tile_caption_inset"
                    android:background="@color/divider" />

                <LinearLayout style="@style/Widget.Maichi.TileCaption">
                    <TextView
                        style="@style/Widget.Maichi.TileTitle"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:text="@string/settings" />

                    <TextView
                        style="@style/Widget.Maichi.TileDetail"
                        android:importantForAccessibility="no"
                        android:text="@string/settings_tile_detail" />
                </LinearLayout>
            </LinearLayout>
        </com.maichimod.prototype.ContentLayout>
    </FrameLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1.35" />
</com.maichimod.prototype.ContentLayout>
