<?xml version="1.0" encoding="utf-8"?>
<com.maichimod.prototype.ContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/monitor_page"
    style="@style/Widget.Maichi.Screen"
    android:visibility="gone">

    <FrameLayout style="@style/Widget.Maichi.PageHeader">
        <Button
            android:id="@+id/monitor_back"
            style="@style/Widget.Maichi.PageBack"
            android:text="@string/monitor" />

        <TextView
            style="@style/Widget.Maichi.PageTitle"
            android:text="@string/unit_door_station" />

        <TextView
            android:id="@+id/monitor_state"
            style="@style/Widget.Maichi.Status"
            android:accessibilityLiveRegion="polite" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/monitor_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/tile_gap"
        android:layout_weight="1"
        android:background="@drawable/settings_panel"
        android:padding="1dp">

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:contentDescription="@string/unit_camera_preview"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/monitor_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/monitor_message"
                style="@style/Widget.Maichi.SectionTitle"
                android:accessibilityLiveRegion="polite" />

            <Button
                android:id="@+id/retry_monitor"
                style="@style/Widget.Maichi.PrimaryButton"
                android:layout_marginTop="14dp"
                android:text="@string/retry_monitor"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</com.maichimod.prototype.ContentLayout>
