<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns0="http://schemas.android.com/tools">
  <style name="Theme.Maichi" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans-serif</item>
    <item name="themePrimary">#A3E635</item>
    <item name="themeOnPrimary">#262626</item>
    <item name="themeSurface">#FBFEF7</item>
    <item name="themeSelection">#EEFBDB</item>
    <item name="themeShell">#F5F7F0</item>

    <item name="android:colorAccent">@color/primary</item>
    <item name="android:colorControlActivated">@color/text</item>
    <item name="android:colorControlNormal">@color/text</item>
    <item name="android:textColorHighlight">@color/control_selected</item>
    <item name="android:windowBackground">@color/background</item>
    <item name="android:navigationBarColor">@color/background</item>
    <item name="android:statusBarColor">@color/background</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar" ns0:targetApi="27">true</item>
    <item name="android:alertDialogTheme">@style/Theme.Maichi.Dialog</item>
  </style>
  <style name="Theme.Maichi.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
    <item name="android:colorAccent">@color/primary</item>
    <item name="android:colorControlActivated">@color/text</item>
    <item name="android:colorControlNormal">@color/text</item>
    <item name="android:textColorHighlight">@color/control_selected</item>
    <item name="android:colorBackgroundFloating">@color/panel</item>
    <item name="android:windowElevation">0dp</item>
    <item name="android:windowBackground">@color/panel</item>
    <item name="android:fontFamily">sans-serif</item>
  </style>
  <style name="Widget.Maichi.Screen" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:layout_gravity">center_horizontal</item>
    <item name="android:orientation">vertical</item>
    <item name="android:paddingHorizontal">@dimen/screen_gutter</item>
    <item name="android:paddingVertical">@dimen/screen_vertical</item>
    <item name="android:layout_margin">@dimen/workspace_margin</item>
    <item name="android:background">@drawable/workspace_surface</item>
  </style>
  <style name="Widget.Maichi.PageHeader" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">@dimen/page_header_height</item>
    <item name="android:paddingBottom">16dp</item>
    <item name="android:background">@drawable/page_header_rule</item>
  </style>
  <style name="Widget.Maichi.PageTitle" parent="">
    <item name="android:layout_width">wrap_content</item>
